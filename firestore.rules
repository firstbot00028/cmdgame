rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'imageUrl', 'category', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.price is number && data.price >= 0
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.category in ['Logo', 'Livery', 'Car']
        && (data.status == null || data.status in ['Available', 'Sold Out'])
        && data.description is string
        && data.createdAt == request.time;
    }

    function isValidOrder(data) {
       return data.keys().hasAll(['productId', 'productName', 'customerName', 'customerPhone', 'address', 'totalAmount', 'status', 'createdAt'])
        && data.customerName is string && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() <= 20
        && data.address is string && data.address.size() <= 500
        && data.totalAmount is number
        && data.status in ['Ordered', 'Confirmed', 'Cancelled', 'Shipped', 'Delivered']
        && data.createdAt == request.time;
    }

    function isAdmin() { return true; } // Placeholder for this specific app's simple admin needs

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products: Anyone can read, only "admin" (for now true) can write
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidProduct(incoming());
      allow update: if isValidProduct(incoming());
      allow delete: if true; 
    }

    // Orders: Anyone can create
    match /orders/{orderId} {
      allow create: if isValidOrder(incoming());
      allow read: if true; 
      allow list: if true;
      allow update: if (
        // Allow status updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['Ordered', 'Confirmed', 'Cancelled', 'Shipped', 'Delivered']
      ) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
