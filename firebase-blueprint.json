{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A CPM car logo or livery for sale",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["Logo", "Livery", "Car"] },
        "status": { "type": "string", "enum": ["Available", "Sold Out"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "imageUrl", "category", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "An order for a CPM item",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "address": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Ordered", "Confirmed", "Cancelled", "Shipped", "Delivered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "customerName", "customerPhone", "status"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Store all available items for sale"
    },
    "orders": {
      "schema": "Order",
      "description": "Store customer orders"
    }
  }
}
